{%- set mieru_enabled = mita is defined and mita -%}
{%- set hysteria_enabled = hysteria is defined and hysteria -%}
{%- set trusttunnel_enabled = trusttunnel is defined and trusttunnel -%}
{%- set hysteria_name = "🎭 Для-тиктока" if user.ios_user else "📶 Резерв быстрый" -%}
tcp-concurrent: true
keep-alive-interval: 60
keep-alive-idle: 120
disable-keep-alive: false

proxies:
{%- if mieru_enabled %}
  - name: 📶 Резерв
    type: mieru
    server: {{ domain }}
{%- if mita.port is not none %}
    port: {{ mita.port }}
{%- elif mita.port_range is not none %}
    port-range: "{{ mita.port_range }}"
{%- endif %}
    transport: {{ mita.protocol.value }}
    multiplexing: MULTIPLEXING_LOW
    udp: true
    username: {{ user.name }}
    password: {{ user.password }}
{% endif %}

{%- if hysteria_enabled %}
  - name: {{ hysteria_name }}
    type: hysteria2
    server: {{ domain }}
    port: {{ hysteria.port }}
    udp: true
    alpn:
      - h3
    password: "{{ user.name }}:{{ user.password }}"
{% endif %}

{%- if trusttunnel_enabled %}
  - name: ⚡ Стабильный
    type: trusttunnel
    server: {{ domain }}
    port: {{ trusttunnel.port }}
    sni: {{ domain }}
    udp: true
    quic: false
    health-check: true
    username: {{ user.name }}
    password: {{ user.password }}

  - name: ⚡ Быстрый
    type: trusttunnel
    server: {{ domain }}
    port: {{ trusttunnel.port }}
    sni: {{ domain }}
    udp: true
    quic: true
    health-check: true
    username: {{ user.name }}
    password: {{ user.password }}
{%- endif %}

proxy-groups:
  - name: PROXY
    type: fallback
    proxies:
{%- if trusttunnel_enabled %}
    - "⚡ Основной"
{%- endif %}
{%- if hysteria_enabled %}
    - "{{ hysteria_name }}"
{%- endif %}
{%- if mieru_enabled %}
    - "📶 Резерв"
{%- endif %}
    - DIRECT
    interval: 0
    lazy: false

{% if trusttunnel_enabled %}
  - name: ⚡ Основной
    type: fallback
    proxies:
    - "⚡ Стабильный"
    - "⚡ Быстрый"
    interval: 0
    lazy: false
    hidden: true
{%- endif %}

  - name: GLOBAL
    type: fallback
    proxies:
{%- if hysteria_enabled %}
    - "{{ hysteria_name }}"
{%- endif %}
    - PROXY
    interval: 0
    lazy: false

dns:
  enable: true
  ipv6: false
  prefer-h3: false
  enhanced-mode: fake-ip
  dns-hijack: []
  default-nameserver:
    - 77.88.8.8
    - 9.9.9.9
  nameserver:
    - https://9.9.9.9/dns-query
    - https://77.88.8.8/dns-query
  proxy-server-nameserver:
    - https://77.88.8.8/dns-query
    - https://9.9.9.9/dns-query

