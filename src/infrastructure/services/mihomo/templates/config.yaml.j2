mixed-port: {{ proxy_port }}
allow-lan: false
bind-address: '*'
mode: rule
log-level: error
ipv6: true
external-controller: 127.0.0.1:10100
secret: ""

proxies:
  - name: trusttunnel
    type: trusttunnel
    server: {{ hostname }}
    port: {{ port }}
    username: {{ username }}
    password: {{ password }}
    sni: {{ hostname }}
    quic: {{ quic }}
    udp: true
    health-check: true

rules:
  - DOMAIN-SUFFIX,{{ direct_rule_domain }},DIRECT
  - MATCH,trusttunnel
