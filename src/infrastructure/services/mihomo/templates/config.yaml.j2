mixed-port: {{ proxy_port }}
allow-lan: false
bind-address: '*'
mode: rule
log-level: error
ipv6: true
external-controller: 127.0.0.1:{{ ctrl_port }}
secret: "{{ secret }}"

proxies:
  - name: trusttunnel
    type: trusttunnel
    server: {{ hostname }}
    port: {{ port }}
    username: {{ username }}
    password: {{ password }}
    sni: {{ hostname }}
    quic: {{ quic }}
    udp: true
    health-check: true

rules:
{%- if direct_rule_domain is defined and direct_rule_domain %}
  - DOMAIN-SUFFIX,{{ direct_rule_domain }},DIRECT
{%- endif %}
  - MATCH,trusttunnel
