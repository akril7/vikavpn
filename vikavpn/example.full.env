# ======================================================================
# VIKAVPN — пример конфигурации
# cp example.full.env .env && заполните значения
# ======================================================================

# ---- Общие ----
DEBUG=no
TIMEZONE_HOURS_DELTA=3
DB_URL=sqlite+aiosqlite:///./vikavpn.db

# ---- TLS / домен (обязательно) ----
DOMAIN=vpn.example.com
CERT_PATH=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
KEY_PATH=/etc/letsencrypt/live/vpn.example.com/privkey.pem

# ---- Сайт-заглушка ----
SITE_TITLE=VIKA-WASSUP
SITE_PORT=7071
SITE_EXTRA_PORTS=[443]
SITE_NAME=vikavpn-site

# ---- Clash ----
CLASH_CONFIGS_URLPATH=/sub/

# ---- Mita ----
MITA_PORT_RANGE=10000-10127
MITA_PROTOCOL=UDP
MITA_SERVICE_NAME=mita
MITA_VERSION=3.36.1

# ---- Hysteria ----
HYSTERIA_PORT=11443
HYSTERIA_DOCKER_IMAGE_NAME=teddysun/hysteria
HYSTERIA_DOCKER_CONTAINER_NAME=hysteria

# ---- MTProxyL ----
MTPROXYL_PORT=7443
MTPROXYL_MODE=manager
MTPROXYL_USE_ZAPRET2=yes
MTPROXYL_SNI=aeza.ru
MTPROXYL_DEFAULT_USER=default
MTPROXYL_DEFAULT_USER_UUID=0123456789abcdef0123456789abcdef
MTPROXYL_SECRETS_PATH=/opt/mtproxyl/secrets.conf
MTPROXYL_INSTALL_SCRIPT_LINK=https://raw.githubusercontent.com/Liafanx/MTProxyL/main/install.sh

# ---- TrustTunnel ----
TRUSTTUNNEL_PORT=8443
TRUSTTUNNEL_SNI=apple.com
TRUSTTUNNEL_SERVICE_NAME=vikavpn-trusttunnel
TRUSTTUNNEL_ARCHIVE_DOWNLOAD_LINK=https://github.com/akril7/TrustTunnel/releases/download/0.0.0/trusttunnel-patched-v1.1.0-linux-x86_64.tar.gz

# ---- YooMoney (обязательно) ----
YOOMONEY_RECEIVER=4100111111111111
YOOMONEY_SECRET=change_me
YOOMONEY_FEE_PERCENT=3.0

# ---- Telegram bot (обязательно) ----
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_USERNAME=my_vpn_bot
TELEGRAM_ADMIN_USERNAME=admin
TELEGRAM_EXPIRE_NOTIF_HOUR=15
TELEGRAM_EXPIRE_NOTIF_MINUTE=0

# ---- Webhook ----
WEBHOOK_URLPATH=/webhook
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8081
WEBHOOK_YOOMONEY_PAYMENT_URLPATH=/yoomoney/payment
WEBHOOK_HYSTERIA_AUTH_URLPATH=/hysteria/auth

# ---- Disabler ----
DISABLER_HOURS_DELAY=1