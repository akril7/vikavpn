# ==============================================================================
# ОБЩИЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ (config/app.py)
# ==============================================================================

# Режим отладки (yes/true/1 — включён, остальное — выключен)
DEBUG=false

# Смещение часового пояса в часах от UTC (например, 3 для Москвы)
TIMEZONE_HOURS_DELTA=3

# SNI для маскировки трафика (используется в MTProxyL и TrustTunnel)
SNI=aeza.ru

# URL подключения к базе данных (async)
DB_URL=postgresql+asyncpg://vikavpn:changeme@127.0.0.1:5432/vikavpn

# ==============================================================================
# TLS / ДОМЕН (config/tls.py)
# ==============================================================================
# ВНИМАНИЕ: пути должны указывать на существующие файлы, иначе приложение упадёт.
# Для Let's Encrypt обычно это:
#   /etc/letsencrypt/live/<domain>/fullchain.pem
#   /etc/letsencrypt/live/<domain>/privkey.pem

# Основной домен сервера
SERVER_NAME=example.com

# Путь к сертификату
CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem

# Путь к приватному ключу
KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# ==============================================================================
# CLASH (config/clash.py)
# ==============================================================================
# Префикс переменных: CLASH_

# Директория для хранения сгенерированных конфигов Clash
CLASH_CONFIGS_STORE_DIR=/opt/vikavpn/clash/configs

# URL-префикс для доступа к конфигам через веб-сервер
CLASH_URL_CONFIG_PATH=/sub/

# ==============================================================================
# HYSTERIA (config/hysteria.py)
# ==============================================================================
# Префикс переменных: HYSTERIA_

# Порт Hysteria
HYSTERIA_PORT=11443

# URL маскировки (на какой сайт маскируется трафик)
HYSTERIA_MASK_URL=http://127.0.0.1:7071

# Путь к конфигу Hysteria
HYSTERIA_CONFIG_PATH=/opt/vikavpn/hysteria/hysteria.yaml

# Docker-образ
HYSTERIA_DOCKER_IMAGE_NAME=teddysun/hysteria

# Имя Docker-контейнера
HYSTERIA_DOCKER_CONTAINER_NAME=hysteria

# ==============================================================================
# MITA (config/mita.py)
# ==============================================================================
# Префикс переменных: MITA_

# Диапазон портов (формат: "start-end")
MITA_PORT_RANGE=10000-10127

# Протокол: TCP или UDP
MITA_PROTOCOL=UDP

# Ссылка на .deb-пакет для установки
MITA_PACKAGE_DOWNLOAD_LINK=https://github.com/enfein/mieru/releases/download/v3.36.1/mita_3.36.1_amd64.deb

# Путь к конфигу Mita
MITA_CONFIG_PATH=/opt/vikavpn/mita/mita.json

# ==============================================================================
# MTPROXYL (config/mtproxyl.py)
# ==============================================================================
# Префикс переменных: MTPROXYL_

# Порт MTProxyL
MTPROXYL_PORT=7443

# Имя пользователя по умолчанию
MTPROXYL_DEFAULT_USER=default

# UUID пользователя по умолчанию
MTPROXYL_DEFAULT_USER_UUID=c97a7565cf5146b63d8e31f8f95da840

# Путь к файлу секретов
MTPROXYL_SECRETS_PATH=/opt/mtproxyl/secrets.conf

# Ссылка на скрипт установки
MTPROXYL_INSTALL_SCRIPT_LINK=https://raw.githubusercontent.com/Liafanx/MTProxyL/main/install.sh

# Режим работы: manager или reanimator
MTPROXYL_MODE=manager

# Использовать ли Zapret2
MTPROXYL_USE_ZAPRET2=true

# ==============================================================================
# TRUSTTUNNEL (config/trusttunnel.py)
# ==============================================================================
# Префикс переменных: TRUSTTUNNEL_

# Порт TrustTunnel
TRUSTTUNNEL_PORT=8443

# Имя systemd-сервиса
TRUSTTUNNEL_SERVICE=trusttunnel

# Директория установки
TRUSTTUNNEL_INSTALL_DIR=/opt/vikavpn/trusttunnel

# Ссылка на архив
TRUSTTUNNEL_ARCHIVE_DOWNLOAD_LINK=https://github.com/TrustTunnel/TrustTunnel/releases/download/v1.1.0/trusttunnel-v1.1.0-linux-x86_64.tar.gz

# ==============================================================================
# NGINX (config/webserver.py — NginxSettings)
# ==============================================================================
# Префикс переменных: NGINX_

# Директория доступных сайтов
NGINX_AVAILABLE_PATH=/etc/nginx/sites-available

# Директория включённых сайтов
NGINX_ENABLED_PATH=/etc/nginx/sites-enabled

# Имя systemd-сервиса Nginx
NGINX_SERVICE_NAME=nginx

# Имя файла конфига сайта
NGINX_SITE_NAME=vikavpn-webserver

# ==============================================================================
# WEBSERVER (config/webserver.py — WebServerSettings)
# ==============================================================================
# Префикс переменных: WEBSERVER_
# ВНИМАНИЕ: ports — список, задаётся через JSON (см. ниже)

# Заголовок сайта
WEBSERVER_TITLE=VIKA-WASSUP

# Порты для прослушивания (JSON-массив)
WEBSERVER_PORTS=[443]

# Корневая директория веб-сервера
WEBSERVER_ROOT=/opt/vikavpn/webserver

# ==============================================================================
# YOOMONEY (config/yoomoney.py)
# ==============================================================================
# Префикс переменных: YOOMONEY_

# Номер кошелька получателя
YOOMONEY_RECEIVER=4100111111111111

# Секрет для проверки подписи вебхука
YOOMONEY_SECRET=changeme_secret

# Имя systemd-сервиса вебхука
YOOMONEY_WEBHOOK_SERVICE=yoomoney-webhook

# Путь вебхука
YOOMONEY_WEBHOOK_PATH=/webhook/yoomoney

# Хост, на котором слушает вебхук
YOOMONEY_WEBHOOK_HOST=127.0.0.1

# Порт вебхука
YOOMONEY_WEBHOOK_PORT=8081
