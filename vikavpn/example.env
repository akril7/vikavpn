# ============================== APP ==============================
# логи SQL и подробный вывод
DEBUG=false
# часовой пояс для отображения дат (UTC+3)
TIMEZONE_HOURS_DELTA=3
# пример для PostgreSQL: postgresql+asyncpg://user:pass@host/db
DB_URL=sqlite+aiosqlite:///vikavpn.db

# ============================== TLS ================================
# domain = SERVER_NAME (валидация: cert/key должны существовать на диске)
SERVER_NAME=vpn.example.com
CERT_PATH=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
KEY_PATH=/etc/letsencrypt/live/vpn.example.com/privkey.pem
# маскировочный SNI для tg-прокси
SNI=aeza.ru

# ============================== BOT ================================
# токен от @BotFather
TELEGRAM_TOKEN=123456:ABC-DEF...
# username бота без @
TELEGRAM_USERNAME=vikavpn_bot
# поддержка в /help (без @)
TELEGRAM_ADMIN_USERNAME=admin

# ============================== YOOMONEY ===========================
# кошелёк получателя
YOOMONEY_RECEIVER=41001XXXXXXXXXXX
# для проверки подписи webhook
YOOMONEY_SECRET=very-secret-string

# ============================== PORTS ====================
HYSTERIA_PORT=11443
TRUSTTUNNEL_PORT=8443
MTPROXYL_PORT=7443
# UDP-диапазон mieru
MITA_PORT_RANGE=10000-10127
# UDP или TCP
MITA_PROTOCOL=UDP
# порт nginx
WEBSERVER_PORT=7071

# ============================== OPTIONAL ===========================
# заголовок index.html
# WEBSERVER_TITLE=VIKA-WASSUP

# имя конфига sites-available
# NGINX_SITE_NAME=vikavpn-webserver

# час ежедневной чистки просроченных подписок (UTC)
# CLEANUP_HOUR=1
# CLEANUP_MINUTE=0

# HYSTERIA_MASK_URL=http://127.0.0.1:7071
# MTPROXYL_USE_ZAPRET2=true
# CLASH_CONFIGS_STORE_DIR=/opt/vikavpn/clash/configs