# ==============================================================================
#                            VIKA-WASSUP CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
#                                 ОБЩИЕ
# ------------------------------------------------------------------------------

# Включает отладочный режим. Принимает: true/false, yes/no, 1/0, on/off
DEBUG=false

# Смещение часового пояса относительно UTC (в часах)
TIMEZONE_HOURS_DELTA=0

# SNI для маскировки трафика
SNI=aeza.ru

# Строка подключения к базе данных (обязательна)
DB_URL=

# ------------------------------------------------------------------------------
#                                 TLS / ДОМЕН
# ------------------------------------------------------------------------------

# Домен, на котором работает сервер
DOMAIN=example.com

# Путь к сертификату (обязательнен)
CERT_PATH=/etc/ssl/certs/example.com.crt

# Путь к приватному ключу (обязателен)
KEY_PATH=/etc/ssl/private/example.com.key

# ------------------------------------------------------------------------------
#                                 NGINX
# ------------------------------------------------------------------------------

# Папка с доступными конфигами сайтов
NGINX_AVAILABLE_PATH=/etc/nginx/sites-available

# Папка с активными конфигами (симлинки)
NGINX_ENABLED_PATH=/etc/nginx/sites-enabled

# Имя systemd-сервиса Nginx
NGINX_SERVICE_NAME=nginx

# Имя сайта в конфигах Nginx
NGINX_SITE_NAME=vikavpn-webserver

# ------------------------------------------------------------------------------
#                                 WEBSERVER
# ------------------------------------------------------------------------------

# Заголовок веб-сервера
WEBSERVER_TITLE=VIKA-WASSUP

# Порты веб-сервера
WEBSERVER_PORT=443,7071

# Корневая папка веб-сервера.
# По умолчанию: {DEFAULT_INSTALL_DIR}/webserver
WEBSERVER_ROOT=

# ------------------------------------------------------------------------------
#                                 HYSTERIA
# ------------------------------------------------------------------------------

# Порт Hysteria
HYSTERIA_PORT=11443

# URL для маскировки
HYSTERIA_MASK_URL=http://127.0.0.1:7071

# Путь для сохранения конфига Hysteria.
# По умолчанию: {DEFAULT_INSTALL_DIR}/hysteria/hysteria.yaml
HYSTERIA_CONFIG_PATH=

# Имя Docker-образа
HYSTERIA_DOCKER_IMAGE_NAME=teddysun/hysteria

# Имя Docker-контейнера
HYSTERIA_DOCKER_CONTAINER_NAME=hysteria

# ------------------------------------------------------------------------------
#                                    MITA
# ------------------------------------------------------------------------------

# Диапазон портов в формате "start-end"
MITA_PORT_RANGE=10000-10127

# Протокол: TCP или UDP
MITA_PROTOCOL=UDP

# Ссылка на .deb-пакет
MITA_PACKAGE_DOWNLOAD_LINK=https://github.com/enfein/mieru/releases/download/v3.36.1/mita_3.36.1_amd64.deb

# Путь для сохранения конфига mita.
# По умолчанию: {DEFAULT_INSTALL_DIR}/mita/mita.json
MITA_CONFIG_PATH=

# ------------------------------------------------------------------------------
#                                 TRUSTTUNNEL
# ------------------------------------------------------------------------------

# Порт TrustTunnel
TRUSTTUNNEL_PORT=8443

# Имя systemd-сервиса
TRUSTTUNNEL_SERVICE=trusttunnel

# Папка установки.
# По умолчанию: {DEFAULT_INSTALL_DIR}/trusttunnel
TRUSTTUNNEL_INSTALL_DIR=

# Ссылка на архив
TRUSTTUNNEL_ARCHIVE_DOWNLOAD_LINK=https://github.com/TrustTunnel/TrustTunnel/releases/download/v1.1.0/trusttunnel-v1.1.0-linux-x86_64.tar.gz

# ------------------------------------------------------------------------------
#                                 MTPROXYL
# ------------------------------------------------------------------------------

# Порт MTProxyL (1024–49151)
MTPROXYL_PORT=7443

# Имя пользователя по умолчанию
MTPROXYL_DEFAULT_USER=default

# UUID пользователя по умолчанию
MTPROXYL_DEFAULT_USER_UUID=c97a7565cf5146b63d8e31f8f95da840

# Путь к файлу с секретами
MTPROXYL_SECRETS_PATH=/opt/mtproxyl/secrets.conf

# Ссылка на установочный скрипт
MTPROXYL_INSTALL_SCRIPT_LINK=https://raw.githubusercontent.com/Liafanx/MTProxyL/main/install.sh

# Режим работы: manager или reanimator
MTPROXYL_MODE=manager

# Использовать Zapret2
MTPROXYL_USE_ZAPRET2=true

# ------------------------------------------------------------------------------
#                                 CLASH
# ------------------------------------------------------------------------------

# Папка для сохранения конфигов Clash.
# По умолчанию: {DEFAULT_INSTALL_DIR}/clash/configs
CLASH_CONFIGS_STORE_DIR=